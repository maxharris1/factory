# Max creates /etc/factory-dashboard/http.env (owner root, group
# factory-dash, mode 0640, no secrets in it):
#   TAILNET_IP=<this node's `tailscale ip -4`>
#   DASHBOARD_DIR=<the directory orch.yml dashboard.push.remote_dir names>
#   DASHBOARD_PORT=8090
#
# Optional GitHub actions (comments and the hold OK as Max, README
# "Dashboard"). They are off unless DASHBOARD_GITHUB_CLIENT_ID is set. The
# client id of an OAuth App with device flow on is public, not a secret:
#   DASHBOARD_GITHUB_CLIENT_ID=<the OAuth App's client id>
#   DASHBOARD_APPROVER=maxharris1
#   DASHBOARD_ACTION_CLIENTS=<Max's phone and laptop tailnet IPv4s, comma list>
#   DASHBOARD_ACTIONS_AUDIT=<absolute path of the JSONL audit file for /api/act>
#   DASHBOARD_SETTINGS_SPOOL=<absolute path of the settings request spool>
#   DASHBOARD_SIGNIN_RELAY=<absolute path of the account sign-in relay>
#   DASHBOARD_SESSION_STORE=<absolute 0700 dir owned by factory-dash for persistent per-device sessions>
#   DASHBOARD_SESSION_DAYS=<optional 1-365; default 90 when DASHBOARD_SESSION_STORE is set>
#
# Never run it as cursor-bot or another bot account: a bot that shares the
# process's user could read the in-memory GitHub token.
# The spool, relay and audit paths need a drop-in with BindPaths=, which the
# install step (#1503) writes.
[Unit]
Description=Factory dashboard server (tailnet only, read-only)
Conflicts=factory-dashboard.service
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=factory-dash
Group=factory-dash
SupplementaryGroups=cursor-bot
EnvironmentFile=/etc/factory-dashboard/http.env
ExecStartPre=/usr/bin/python3 -I /usr/local/lib/factory-dashboard/factory-dashboard-http.py --check
ExecStart=/usr/bin/python3 -I /usr/local/lib/factory-dashboard/factory-dashboard-http.py
Restart=on-failure
RestartSec=30

NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/cursor-bot/factory-dashboard
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
