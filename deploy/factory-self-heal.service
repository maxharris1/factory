[Unit]
Description=Factory self-heal: restart down or stale-code components (deploy/self-heal.sh)

[Service]
Type=oneshot
ExecStart=%h/factory/deploy/self-heal.sh once
SuccessExitStatus=79
# Services self-heal restarts must outlive this oneshot run.
KillMode=process
# 0 lands at the user manager's floor.
OOMScoreAdjust=0
Environment=PYTHONUNBUFFERED=1
