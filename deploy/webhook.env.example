# Grok webhook variables for orch poll. Copy to ~/.config/factory/webhook.env,
# mode 0600, and fill in the values. Never commit the filled-in file.
# Names match orch.yml grok.webhook_url_env, webhook_auth_env, webhook_key_env.
# Quote every value: run-poller.sh sources this file in bash, and an unquoted
# value with a space (Bearer <key>) does not set the variable.
FACTORY_WEBHOOK_URL=""
# Full Authorization header value, sent verbatim, e.g. "Bearer <key>".
# It wins over FACTORY_WEBHOOK_KEY when both are set.
FACTORY_WEBHOOK_AUTH=""
# Or the bare key; orch sends "Bearer <key>". Set AUTH or KEY.
FACTORY_WEBHOOK_KEY=""
