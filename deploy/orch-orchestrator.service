# Factory pull-based universal orchestrator loop (E3-1).
#
# Runs `orch wait orchestrator` in a user unit so any configured AI harness
# (Claude, Codex, Gemini, Grok, or Cursor) can claim wakes from driver_inbox
# at zero idle token cost without vendor webhooks or 30/hr routine limits.
#
# Configure ORCH_DB and your runner wrapper in ~/.config/factory/orchestrator.env.
# Restart=always brings a crashed orchestrator runner back automatically; any
# active wake lease expires and is reclaimed cleanly on restart.
#
# Nothing in this repository installs, enables or starts this unit.
[Unit]
Description=Factory pull-based universal orchestrator (orch wait orchestrator)

[Service]
Type=simple
WorkingDirectory=%h/factory
EnvironmentFile=-%h/.config/factory/orchestrator.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/orch wait orchestrator --lease-seconds 300
Restart=always
RestartSec=5
RestartPreventExitStatus=79
KillMode=process

[Install]
WantedBy=default.target
